# Next.js (copy to .env.local). `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL for you.
NEXT_PUBLIC_CONVEX_URL=
# Domain used for customer sites, e.g. orikly.ng (use "localhost" locally to test slug.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=
# Public URL of the main site, no trailing slash, e.g. https://orikly.ng
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: landing page video (mp4 URL)
NEXT_PUBLIC_LANDING_VIDEO_URL=
# WhatsApp support number, digits only with country code, e.g. 2348012345678
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ---- Convex environment variables (set with `npx convex env set NAME value`, NOT in .env.local) ----
# SITE_URL                 http://localhost:3000 (set to your live URL in production)
# JWT_PRIVATE_KEY, JWKS    created by `npx @convex-dev/auth` or `node scripts/generate-keys.mjs`
# AUTH_RESEND_KEY          Resend API key (email codes)
# AUTH_EMAIL_FROM          e.g. "Orikly <login@orikly.ng>" (domain must be verified in Resend)
# AUTH_DEV_LOG_CODES       "true" to print login codes in Convex logs (testing only, never in production)
# ADMIN_EMAILS             comma-separated admin emails, e.g. you@example.com
# BANK_NAME, BANK_ACCOUNT_NUMBER, BANK_ACCOUNT_NAME   shown to customers on the transfer payment step
